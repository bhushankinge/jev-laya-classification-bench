# Copy to ~/.config/laya-jev-bench.env (or point LJB_ENV_FILE at it). Never commit real values.
JEV_API_KEY=            # TypeSafe System One API key
PCAI_API_KEY=           # bearer token for the Qwen OpenAI-compatible endpoint
QWEN_ENDPOINT=https://your-vllm-host/v1/chat/completions
CRM_DB_DSN=postgresql://readonly_user:password@db-host:5432/crm   # read-only; used only by gold.py and the sample builder
LAYA_MODEL_DIR=/path/to/models/laya          # local download of convaiinnovations/laya
LAYA_PYTHON=/path/to/laya-venv/bin/python    # interpreter with the laya package + torch CUDA
